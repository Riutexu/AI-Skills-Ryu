# Plantilla de entorno de ejemplo. Copiar a .env.example y rellenar valores reales SOLO en local y en el panel del proveedor.

# URL publica de la aplicacion
NEXT_PUBLIC_SITE_URL=

# API backend
API_URL=

# Base de datos (solo si la app la consume directamente)
DATABASE_URL=

# Claves de servicios externos
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=

# Feature flags
NEXT_PUBLIC_HABILITAR_NUEVO_CHECKOUT=