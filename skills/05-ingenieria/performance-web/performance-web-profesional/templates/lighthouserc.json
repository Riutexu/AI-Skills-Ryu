{
  "ci": {
    "collect": {
      "url": ["https://miweb.com/", "https://miweb.com/productos", "https://miweb.com/checkout"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": { "cpuSlowdownMultiplier": 4, "downloadThroughputKbps": 1638, "uploadThroughputKbps": 675 }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "lcp": ["error", { "maxNumericValue": 2500 }],
        "cls": ["error", { "maxNumericValue": 0.1 }],
        "inp": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}